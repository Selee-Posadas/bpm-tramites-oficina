# ==============================================================================
# BPM DE TRÁMITES DE OFICINA — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bpm_tramites
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bpm_tramites?schema=public

# Backend API (NestJS + Fastify)
PORT=3001
NODE_ENV=development
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-bpm-tramites-enterprise-2026!
JWT_EXPIRES_IN=1d

# Azure Entra ID / Mock Auth
USE_MOCK_AUTH=true
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=mock-secret

# Frontend (Next.js 19)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_ENV=development
